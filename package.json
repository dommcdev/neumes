    "test:browser": "playwright test",
    "test:gregorio": "NEUMES_GREGORIO=1 bun test tests/gregorio.test.ts",
    "cli": "bun src/cli.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "latest",
    "@types/wicg-file-system-access": "^2023.10.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.149.0"
  }
}
